module std.env;

import std.env_native as native;

export fn get(key: string) : string {
    return native.get(key);
};

export fn get_or(key: string, fallback: string) : string {
    if (native.has(key)) {
        return native.get(key);
    }
    return fallback;
};

export fn has(key: string) : bool {
    return native.has(key);
};