{
  "name": "Aura",
  "scopeName": "source.aura",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aura",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.aura" }
          },
          "end": "$"
        },
        {
          "name": "comment.block.aura",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.aura" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.aura" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aura",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.aura" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.aura" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aura",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aura",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.aura",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aura",
          "match": "\\b(module|import|as|export|fn|return|if|else|while|iter|of|with|handle|effect|raises|transaction|unsafe|go|await|comptime|actor|state|msg|query)\\b"
        },
        {
          "name": "storage.modifier.aura",
          "match": "\\b(var|const|shared|thread_local|implements)\\b"
        },
        {
          "name": "keyword.operator.word.aura",
          "match": "\\b(and|or|not|mod|div|drop|take|reverse|filter|transform)\\b"
        },
        {
          "name": "keyword.other.contract.aura",
          "match": "\\b(requires|ensures|invariant)\\b"
        },
        {
          "name": "constant.language.aura",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.aura",
          "match": "\\b(type|struct|enum|interface|context|void|never|int|float|bool|string|ptr|ref)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.aura",
          "match": "->|\\.\\.\\.|==|!=|<=|>=|&&|\\|\\||[=+\\-*/<>|&!:.;,(){}\\[\\]<>]"
        }
      ]
    }
  }
}
