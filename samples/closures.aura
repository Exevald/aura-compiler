module samples.closures;

import samples.counter_factory as counterFactory;

var add10 = counterFactory.makeAdder(10);
var scale3 = counterFactory.makeScaler(3);

print "Closure add10(7):";
print add10(7);

print "Closure scale3(4):";
print scale3(4);

var numbers = [1, 2, 3, 4];
print "Original numbers:";
print numbers;

numbers[0] = add10(numbers[0]);
numbers[1] = add10(numbers[1]);
numbers[2] = scale3(numbers[2]);
numbers[3] = scale3(numbers[3]);

print "After closures:";
print numbers;
