module samples.enums_and_iterators;

import std.io as io;

enum Option<T> { None | Some(T) }

var selected = Some(42);
var values = [1, 2, 3, 4, 5];

io.println("tag =", selected.tag);
io.println("payload =", selected[0]);

iter (item of values with [
    drop(1),
    take(3),
    reverse,
    filter(fn(v: int) -> v > 2),
    transform(fn(v: int) -> v + 10)
]) {
    io.println("iter =", item);
}
