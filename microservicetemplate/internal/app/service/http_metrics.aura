module microservicetemplate.internal.app.service.http_metrics;

import std.text as text;

actor HttpMetrics {
    state total_requests: int = 0;
    state total_duration_ms: int = 0;

    state responses_2xx: int = 0;
    state responses_3xx: int = 0;
    state responses_4xx: int = 0;
    state responses_5xx: int = 0;
    state responses_other: int = 0;

    state bucket_le_1: int = 0;
    state bucket_le_5: int = 0;
    state bucket_le_10: int = 0;
    state bucket_le_25: int = 0;
    state bucket_le_50: int = 0;
    state bucket_le_100: int = 0;
    state bucket_le_250: int = 0;
    state bucket_le_500: int = 0;
    state bucket_le_1000: int = 0;

    state root_get: int = 0;
    state healthz_get: int = 0;
    state readyz_get: int = 0;
    state dev_token_post: int = 0;
    state tasks_list_get: int = 0;
    state tasks_get_get: int = 0;
    state tasks_create_post: int = 0;
    state tasks_update_put: int = 0;
    state tasks_delete_delete: int = 0;

    msg observe(route_name: string, status_code: int, duration_ms: int) : void {
        total_requests = total_requests + 1;
        total_duration_ms = total_duration_ms + duration_ms;

        if (status_code >= 200 and status_code < 300) {
            responses_2xx = responses_2xx + 1;
        } else if (status_code >= 300 and status_code < 400) {
            responses_3xx = responses_3xx + 1;
        } else if (status_code >= 400 and status_code < 500) {
            responses_4xx = responses_4xx + 1;
        } else if (status_code >= 500 and status_code < 600) {
            responses_5xx = responses_5xx + 1;
        } else {
            responses_other = responses_other + 1;
        }

        if (route_name == "GET /") {
            root_get = root_get + 1;
        } else if (route_name == "GET /healthz") {
            healthz_get = healthz_get + 1;
        } else if (route_name == "GET /readyz") {
            readyz_get = readyz_get + 1;
        } else if (route_name == "POST /api/dev/token") {
            dev_token_post = dev_token_post + 1;
        } else if (route_name == "GET /api/v1/tasks") {
            tasks_list_get = tasks_list_get + 1;
        } else if (route_name == "GET /api/v1/tasks/{id}") {
            tasks_get_get = tasks_get_get + 1;
        } else if (route_name == "POST /api/v1/tasks") {
            tasks_create_post = tasks_create_post + 1;
        } else if (route_name == "PUT /api/v1/tasks/{id}") {
            tasks_update_put = tasks_update_put + 1;
        } else if (route_name == "DELETE /api/v1/tasks/{id}") {
            tasks_delete_delete = tasks_delete_delete + 1;
        }

        if (duration_ms <= 1) {
            bucket_le_1 = bucket_le_1 + 1;
            bucket_le_5 = bucket_le_5 + 1;
            bucket_le_10 = bucket_le_10 + 1;
            bucket_le_25 = bucket_le_25 + 1;
            bucket_le_50 = bucket_le_50 + 1;
            bucket_le_100 = bucket_le_100 + 1;
            bucket_le_250 = bucket_le_250 + 1;
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 5) {
            bucket_le_5 = bucket_le_5 + 1;
            bucket_le_10 = bucket_le_10 + 1;
            bucket_le_25 = bucket_le_25 + 1;
            bucket_le_50 = bucket_le_50 + 1;
            bucket_le_100 = bucket_le_100 + 1;
            bucket_le_250 = bucket_le_250 + 1;
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 10) {
            bucket_le_10 = bucket_le_10 + 1;
            bucket_le_25 = bucket_le_25 + 1;
            bucket_le_50 = bucket_le_50 + 1;
            bucket_le_100 = bucket_le_100 + 1;
            bucket_le_250 = bucket_le_250 + 1;
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 25) {
            bucket_le_25 = bucket_le_25 + 1;
            bucket_le_50 = bucket_le_50 + 1;
            bucket_le_100 = bucket_le_100 + 1;
            bucket_le_250 = bucket_le_250 + 1;
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 50) {
            bucket_le_50 = bucket_le_50 + 1;
            bucket_le_100 = bucket_le_100 + 1;
            bucket_le_250 = bucket_le_250 + 1;
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 100) {
            bucket_le_100 = bucket_le_100 + 1;
            bucket_le_250 = bucket_le_250 + 1;
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 250) {
            bucket_le_250 = bucket_le_250 + 1;
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 500) {
            bucket_le_500 = bucket_le_500 + 1;
            bucket_le_1000 = bucket_le_1000 + 1;
        } else if (duration_ms <= 1000) {
            bucket_le_1000 = bucket_le_1000 + 1;
        }
    }

    query render() : string {
        var body = "";
        body = body + "# HELP microservicetemplate_http_requests_total Total HTTP requests by canonical route.\n";
        body = body + "# TYPE microservicetemplate_http_requests_total counter\n";
        body = body + "microservicetemplate_http_requests_total{method=\"GET\",route=\"/\"} " + text.to_string(root_get) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"GET\",route=\"/healthz\"} " + text.to_string(healthz_get) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"GET\",route=\"/readyz\"} " + text.to_string(readyz_get) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"POST\",route=\"/api/dev/token\"} " + text.to_string(dev_token_post) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"GET\",route=\"/api/v1/tasks\"} " + text.to_string(tasks_list_get) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"GET\",route=\"/api/v1/tasks/{id}\"} " + text.to_string(tasks_get_get) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"POST\",route=\"/api/v1/tasks\"} " + text.to_string(tasks_create_post) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"PUT\",route=\"/api/v1/tasks/{id}\"} " + text.to_string(tasks_update_put) + "\n";
        body = body + "microservicetemplate_http_requests_total{method=\"DELETE\",route=\"/api/v1/tasks/{id}\"} " + text.to_string(tasks_delete_delete) + "\n";

        body = body + "# HELP microservicetemplate_http_responses_total Total HTTP responses by status class.\n";
        body = body + "# TYPE microservicetemplate_http_responses_total counter\n";
        body = body + "microservicetemplate_http_responses_total{class=\"2xx\"} " + text.to_string(responses_2xx) + "\n";
        body = body + "microservicetemplate_http_responses_total{class=\"3xx\"} " + text.to_string(responses_3xx) + "\n";
        body = body + "microservicetemplate_http_responses_total{class=\"4xx\"} " + text.to_string(responses_4xx) + "\n";
        body = body + "microservicetemplate_http_responses_total{class=\"5xx\"} " + text.to_string(responses_5xx) + "\n";
        body = body + "microservicetemplate_http_responses_total{class=\"other\"} " + text.to_string(responses_other) + "\n";

        body = body + "# HELP microservicetemplate_http_request_duration_seconds HTTP request duration in seconds.\n";
        body = body + "# TYPE microservicetemplate_http_request_duration_seconds histogram\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.001\"} " + text.to_string(bucket_le_1) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.005\"} " + text.to_string(bucket_le_5) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.01\"} " + text.to_string(bucket_le_10) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.025\"} " + text.to_string(bucket_le_25) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.05\"} " + text.to_string(bucket_le_50) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.1\"} " + text.to_string(bucket_le_100) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.25\"} " + text.to_string(bucket_le_250) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"0.5\"} " + text.to_string(bucket_le_500) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"1\"} " + text.to_string(bucket_le_1000) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_bucket{le=\"+Inf\"} " + text.to_string(total_requests) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_sum " + text.to_string(total_duration_ms / 1000.0) + "\n";
        body = body + "microservicetemplate_http_request_duration_seconds_count " + text.to_string(total_requests) + "\n";
        return body;
    }
}

export HttpMetrics;

export fn new() : HttpMetrics {
    return HttpMetrics();
};
